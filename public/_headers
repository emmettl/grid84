# Cloudflare Worker static-asset headers (GitHub Pages ignores this file).
# Hashed assets are immutable for a year; the HTML and the grids index
# revalidate; the release marker is never cached.

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Grid84-Hosting: cloudflare-worker

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Grid84-Hosting: cloudflare-worker

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The pages written for search engines: HTML, so they revalidate like the app's
# own index does. Each is a directory with an index.html inside it.
/atlas/*
  Cache-Control: public, max-age=0, must-revalidate

/winter/*
  Cache-Control: public, max-age=0, must-revalidate

/wopr/*
  Cache-Control: public, max-age=0, must-revalidate

/chronicle/*
  Cache-Control: public, max-age=0, must-revalidate

/studies/*
  Cache-Control: public, max-age=0, must-revalidate

/dossier/*
  Cache-Control: public, max-age=0, must-revalidate

/labs/*
  Cache-Control: public, max-age=0, must-revalidate

# The sitemap and the card change rarely and are fetched by machines.
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=86400

/data/hyde/index.json
  Cache-Control: public, max-age=0, must-revalidate

/data/hyde/popc_*
  Cache-Control: public, max-age=86400, must-revalidate

/_release.json
  Cache-Control: no-cache
