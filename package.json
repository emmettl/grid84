{
  "name": "grid84",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Terminal Atlas \u2014 the Grid/84 global cartographic system. Anywhere on Earth. Real geography. Indefensibly dramatic presentation.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4184",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "maplibre-gl": "6.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "packageManager": "npm@11.19.0"
}
