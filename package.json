{
  "name": "grid84",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Terminal Atlas — the Grid/84 global cartographic system. Anywhere on Earth. Real geography. Indefensibly dramatic presentation.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4184",
    "build": "tsc -b && node scripts/briefs.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "briefs": "node scripts/briefs.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "packageManager": "npm@11.21.1"
}
